diff --git a/zluda_dnn/src/impl.rs b/zluda_dnn/src/impl.rs
index 45ec0ed..62d01b7 100644
--- a/zluda_dnn/src/impl.rs
+++ b/zluda_dnn/src/impl.rs
@@ -1333,0 +1334,18 @@ pub mod dnn8 {
+    // All three library properties match the version returned by
+    // cudnnGetVersion(). Never return success with an unwritten output.
+    pub(crate) unsafe fn get_property(
+        property: libraryPropertyType, value: *mut ::core::ffi::c_int,
+    ) -> cudnnStatus_t {
+        if value.is_null() {
+            return Err(cudnnError_t::BAD_PARAM);
+        }
+        let v = match property.0 {
+            0 => cuda_types::cudnn8::CUDNN_MAJOR as i32,
+            1 => cuda_types::cudnn8::CUDNN_MINOR as i32,
+            2 => cuda_types::cudnn8::CUDNN_PATCHLEVEL as i32,
+            _ => return Err(cudnnError_t::BAD_PARAM),
+        };
+        *value = v;
+        Ok(())
+    }
+
@@ -1482,0 +1501,18 @@ pub mod dnn9 {
+    // All three library properties match the version returned by
+    // cudnnGetVersion(). Never return success with an unwritten output.
+    pub(crate) unsafe fn get_property(
+        property: libraryPropertyType, value: *mut ::core::ffi::c_int,
+    ) -> cudnnStatus_t {
+        if value.is_null() {
+            return Err(cudnnError_t::BAD_PARAM);
+        }
+        let v = match property.0 {
+            0 => cuda_types::cudnn9::CUDNN_MAJOR as i32,
+            1 => cuda_types::cudnn9::CUDNN_MINOR as i32,
+            2 => cuda_types::cudnn9::CUDNN_PATCHLEVEL as i32,
+            _ => return Err(cudnnError_t::BAD_PARAM),
+        };
+        *value = v;
+        Ok(())
+    }
