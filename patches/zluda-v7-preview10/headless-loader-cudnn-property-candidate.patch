     if result.is_none() {
+        /* Missing HIP components must never stall headless GPU workloads.
+         * The original TaskDialogIndirect could silently block a CLI,
+         * service or CI child process before any kernel was launched.
+         * Errors are noninteractive by default. Users who explicitly want
+         * the old desktop dialog can opt back in for troubleshooting.
+         */
+        let dependencies = redirect_names.join(" or ");
+        let diagnostic = format!(
+            "[zluda-dependency] ZLUDA failed to load {dependencies}. \
+             Install a compatible HIP SDK/MIOpen runtime or correct HIP_PATH.\n"
+        );
+        let _ = std::io::Write::write_all(&mut std::io::stderr(), diagnostic.as_bytes());
+        if std::env::var("ZLUDA_ALLOW_MISSING_DLL_DIALOG").as_deref() != Ok("1") {
+            return None;
+        }
         let mut title = U16String::from_str("ZLUDA failed to load ");
