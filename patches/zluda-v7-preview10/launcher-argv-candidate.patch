+// Windows passes one command line, not an argv array. Apply MS CRT quoting.
+fn append_windows_argument(command_line: &mut Vec<u16>, arg: &std::ffi::OsStr) {
+    let units: Vec<u16> = arg.encode_wide().collect();
+    let quoted = units.is_empty()
+        || units
+            .iter()
+            .any(|&c| c == b' ' as u16 || c == b'\t' as u16 || c == b'"' as u16);
+    if quoted {
+        command_line.push(b'"' as u16);
+    }
+    let mut slashes = 0usize;
+    for &unit in &units {
+        if unit == b'\\' as u16 {
+            slashes += 1;
+        } else if unit == b'"' as u16 {
+            command_line.extend(std::iter::repeat(b'\\' as u16).take(slashes * 2 + 1));
+            command_line.push(unit);
+            slashes = 0;
+        } else {
+            command_line.extend(std::iter::repeat(b'\\' as u16).take(slashes));
+            slashes = 0;
+            command_line.push(unit);
+        }
+    }
+    command_line.extend(std::iter::repeat(b'\\' as u16).take(if quoted {
+        slashes * 2
+    } else {
+        slashes
+    }));
+    if quoted {
+        command_line.push(b'"' as u16);
+    }
+}
