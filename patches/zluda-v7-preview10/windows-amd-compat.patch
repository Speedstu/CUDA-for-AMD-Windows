+#[cfg(windows)]
+unsafe fn copy_device_pointer_array<T>(
+    hs: &HipsolverVtable,
+    array: *const *mut T,
+    batch_count: i32,
+) -> Result<Vec<*mut T>, cublasError_t> {
+    let mut ptrs = vec![ptr::null_mut::<T>(); batch_count.max(0) as usize];
+    if ptrs.is_empty() {
+        return Ok(ptrs);
+    }
+    let status = (hs.hip_memcpy)(
+        ptrs.as_mut_ptr().cast(),
+        array.cast(),
+        ptrs.len() * mem::size_of::<*mut T>(),
+        2, // hipMemcpyDeviceToHost
+    );
+    if status != 0 || ptrs.iter().any(|p| p.is_null()) {
+        Err(cublasError_t::r#EXECUTION_FAILED)
+    } else {
+        Ok(ptrs)
+    }
+}
+
+#[cfg(windows)]
+macro_rules! impl_geqrf_batched {
+    ($name:ident, $ty:ty, $cuda_type:expr) => {
+        pub(crate) unsafe fn $name(
+            handle: &Handle,
+            m: i32,
+            n: i32,
+            a_array: *const *mut $ty,
+            lda: i32,
+            tau_array: *const *mut $ty,
+            info: *mut i32,
+            batch_count: i32,
+        ) -> cublasStatus_t {
+            if info.is_null() {
+                return Err(cublasError_t::r#INVALID_VALUE);
+            }
+            *info = 0;
+            if m < 0 { *info = -2; return Err(cublasError_t::r#INVALID_VALUE); }
+            if n < 0 { *info = -3; return Err(cublasError_t::r#INVALID_VALUE); }
+            if lda < 1.max(m) { *info = -5; return Err(cublasError_t::r#INVALID_VALUE); }
+            if batch_count < 0 { *info = -8; return Err(cublasError_t::r#INVALID_VALUE); }
+            if batch_count == 0 || m == 0 || n == 0 { return Ok(()); }
+            if a_array.is_null() || tau_array.is_null() {
+                return Err(cublasError_t::r#INVALID_VALUE);
+            }
+
+            let hs = hipsolver()?;
+            let mut stream = hip_runtime_sys::hipStream_t(ptr::null_mut());
+            if let Err(e) = rocblas()?.rocblas_get_stream(handle.rocm_handle, &mut stream) {
+                return Err(e.into());
+            }
+            // PyTorch materializes the pointer arrays on the active CUDA stream.
+            // Synchronize that stream before copying Aarray/TauArray back to host;
+            // otherwise a synchronous D2H copy can race or deadlock with work queued
+            // on a non-default stream that will be reused for the solver launch.
+            if (hs.hip_stream_synchronize)(stream) != 0 {
+                return Err(cublasError_t::r#EXECUTION_FAILED);
+            }
+            let a_ptrs = copy_device_pointer_array(hs, a_array, batch_count)?;
+            let tau_ptrs = copy_device_pointer_array(hs, tau_array, batch_count)?;
+
+            let mut solver_handle = ptr::null_mut::<::core::ffi::c_void>();
+            cublas_error_from_hipsolver((hs.create)(&mut solver_handle))?;
+            let mut params = ptr::null_mut::<::core::ffi::c_void>();
+            if let Err(e) = cublas_error_from_hipsolver((hs.create_params)(&mut params)) {
+                let _ = (hs.destroy)(solver_handle);
+                return Err(e);
+            }
+
+            if let Err(e) = cublas_error_from_hipsolver((hs.set_stream)(solver_handle, stream)) {
+                let _ = (hs.destroy_params)(params);
+                let _ = (hs.destroy)(solver_handle);
+                return Err(e);
+            }
+
+            let mut workspace_device_bytes = 0usize;
+            let mut workspace_host_bytes = 0usize;
+            let query_status = (hs.xgeqrf_buffer_size)(
+                solver_handle, params, m as i64, n as i64,
+                $cuda_type, a_ptrs[0].cast(), lda as i64,
+                $cuda_type, tau_ptrs[0].cast(), $cuda_type,
+                &mut workspace_device_bytes, &mut workspace_host_bytes,
+            );
+            if let Err(e) = cublas_error_from_hipsolver(query_status) {
+                let _ = (hs.destroy_params)(params);
+                let _ = (hs.destroy)(solver_handle);
+                return Err(e);
+            }
+
+            let mut workspace_device = ptr::null_mut::<::core::ffi::c_void>();
+            if workspace_device_bytes > 0 {
+                if (hs.hip_malloc)(&mut workspace_device, workspace_device_bytes) != 0 {
+                    let _ = (hs.destroy_params)(params);
+                    let _ = (hs.destroy)(solver_handle);
+                    return Err(cublasError_t::r#ALLOC_FAILED);
+                }
+            }
+            let mut dev_info = ptr::null_mut::<::core::ffi::c_void>();
+            if (hs.hip_malloc)(&mut dev_info, mem::size_of::<i32>()) != 0 {
+                if !workspace_device.is_null() { let _ = (hs.hip_free)(workspace_device); }
+                let _ = (hs.destroy_params)(params);
+                let _ = (hs.destroy)(solver_handle);
+                return Err(cublasError_t::r#ALLOC_FAILED);
+            }
+            let mut workspace_host = vec![0u8; workspace_host_bytes.max(1)];
+            let workspace_host_ptr = if workspace_host_bytes == 0 { ptr::null_mut() } else { workspace_host.as_mut_ptr().cast() };
+
+            let mut result: cublasStatus_t = Ok(());
+            for i in 0..batch_count as usize {
+                let status = (hs.xgeqrf)(
+                    solver_handle, params, m as i64, n as i64,
+                    $cuda_type, a_ptrs[i].cast(), lda as i64,
+                    $cuda_type, tau_ptrs[i].cast(), $cuda_type,
+                    workspace_device, workspace_device_bytes,
+                    workspace_host_ptr, workspace_host_bytes,
+                    dev_info.cast::<i32>(),
+                );
+                if let Err(e) = cublas_error_from_hipsolver(status) {
+                    result = Err(e);
+                    break;
+                }
+            }
+
+            // Synchronize the actual cuBLAS stream before releasing per-call solver
+            // workspaces. On non-default streams, relying on hipFree's implicit sync
+            // can deadlock or free storage before the queued QR work has completed.
+            if result.is_ok() && (hs.hip_stream_synchronize)(stream) != 0 {
+                result = Err(cublasError_t::r#EXECUTION_FAILED);
+            }
+            let info_free = (hs.hip_free)(dev_info);
+            if info_free != 0 && result.is_ok() {
+                result = Err(cublasError_t::r#EXECUTION_FAILED);
+            }
+            if !workspace_device.is_null() {
+                let work_free = (hs.hip_free)(workspace_device);
+                if work_free != 0 && result.is_ok() {
+                    result = Err(cublasError_t::r#EXECUTION_FAILED);
+                }
+            }
+            let destroy_params_status = (hs.destroy_params)(params);
+            let destroy_status = (hs.destroy)(solver_handle);
+            if result.is_ok() {
+                cublas_error_from_hipsolver(destroy_params_status)?;
+                cublas_error_from_hipsolver(destroy_status)?;
+            }
+            result
+        }
+    };
+}
