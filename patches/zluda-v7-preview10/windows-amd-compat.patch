+        symbol::<unsafe extern "system" fn(*mut CuContext) -> CuResult>(b"cuCtxGetCurrent\0"),
+        symbol::<unsafe extern "system" fn(*mut usize, *mut usize) -> CuResult>(b"cuMemGetInfo_v2\0"),
