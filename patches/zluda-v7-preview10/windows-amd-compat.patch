+                op,
+                m,
+                n,
+                nrhs,
+                a_array.cast::<*mut $roc_ty>(),
+                lda,
+                c_array.cast::<*mut $roc_ty>(),
+                ldc,
+                dev_info_array,
+                batch_size,
+            );
+            status?;
+            Ok(())
+        }
+    };
