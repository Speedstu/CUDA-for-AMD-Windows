+                return Err(cublasError_t::r#INVALID_VALUE);
+            }
+            *info = 0;
+            if m < 0 { *info = -3; return Err(cublasError_t::r#INVALID_VALUE); }
+            if n < 0 { *info = -4; return Err(cublasError_t::r#INVALID_VALUE); }
+            if nrhs < 0 { *info = -5; return Err(cublasError_t::r#INVALID_VALUE); }
+            if lda < 1.max(m) { *info = -7; return Err(cublasError_t::r#INVALID_VALUE); }
+            if ldc < 1.max(m.max(n)) { *info = -9; return Err(cublasError_t::r#INVALID_VALUE); }
+            if batch_size < 0 { *info = -12; return Err(cublasError_t::r#INVALID_VALUE); }
+            if batch_size == 0 || m == 0 || n == 0 || nrhs == 0 { return Ok(()); }
+            if a_array.is_null() || c_array.is_null() || dev_info_array.is_null() {
+                return Err(cublasError_t::r#INVALID_VALUE);
+            }
+            let op = trsm_operation(trans)?;
+            // rocSOLVER's GELS uses conjugate-transpose for complex transposed solves,
+            // while cuBLAS passes CUBLAS_OP_T for real and CUBLAS_OP_C for complex.
+            let status = (rocsolver()?.$field)(
