+    if name.is_null() || length == 0 {
+        return nvmlReturn_t::ERROR_INVALID_ARGUMENT;
+    }
+    let index = match index_from_handle(device) {
+        Ok(i) => i,
+        Err(e) => return e,
+    };
+    if !valid_index(index as u32) {
+        return nvmlReturn_t::ERROR_INVALID_ARGUMENT;
+    }
+    unsafe {
