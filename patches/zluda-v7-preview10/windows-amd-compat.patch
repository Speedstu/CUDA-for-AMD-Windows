+
+type HipfftHandle = *mut c_void;
+type HipfftResult = c_int;
+
+fn from_hipfft(code: HipfftResult) -> cufftResult {
+    match code {
+        0 => Ok(()),
+        1 => Err(cufftError_t::r#INVALID_PLAN),
+        2 => Err(cufftError_t::r#ALLOC_FAILED),
+        3 => Err(cufftError_t::r#INVALID_TYPE),
+        4 => Err(cufftError_t::r#INVALID_VALUE),
+        5 => Err(cufftError_t::r#INTERNAL_ERROR),
+        6 => Err(cufftError_t::r#EXEC_FAILED),
+        7 => Err(cufftError_t::r#SETUP_FAILED),
+        8 => Err(cufftError_t::r#INVALID_SIZE),
+        9 => Err(cufftError_t::r#UNALIGNED_DATA),
+        11 => Err(cufftError_t::r#INVALID_DEVICE),
+        13 => Err(cufftError_t::r#NO_WORKSPACE),
+        14 => Err(cufftError_t::r#NOT_IMPLEMENTED),
+        16 => Err(cufftError_t::r#NOT_SUPPORTED),
+        _ => Err(cufftError_t::r#INTERNAL_ERROR),
+    }
+}
+
+#[cfg(windows)]
+fn hipfft_library() -> Result<&'static Library, cufftError_t> {
+    static LIB: OnceLock<Result<Library, cufftError_t>> = OnceLock::new();
+    let result = LIB.get_or_init(|| unsafe {
+        let hmodule = zluda_windows::try_load_from_self_or_hip_with_message(&["hipfft.dll"])
+            .ok_or(cufftError_t::r#MISSING_DEPENDENCY)?;
+        Ok(Library::from_raw(hmodule.0 as _))
+    });
+    result.as_ref().map_err(|e| *e)
+}
+
+#[cfg(windows)]
+unsafe fn symbol<T: Copy>(name: &'static [u8]) -> Result<T, cufftError_t> {
+    let lib = hipfft_library()?;
+    lib.get::<T>(name)
+        .map(|s| *s)
+        .map_err(|_| cufftError_t::r#MISSING_DEPENDENCY)
+}
+
+#[cfg(not(windows))]
+unsafe fn symbol<T: Copy>(_name: &'static [u8]) -> Result<T, cufftError_t> {
+    Err(cufftError_t::r#MISSING_DEPENDENCY)
+}
+
+struct PlanRegistry {
+    next: i32,
+    plans: HashMap<i32, usize>,
+}
+
+fn registry() -> &'static Mutex<PlanRegistry> {
+    static REGISTRY: OnceLock<Mutex<PlanRegistry>> = OnceLock::new();
+    REGISTRY.get_or_init(|| {
+        Mutex::new(PlanRegistry {
+            next: 1,
+            plans: HashMap::new(),
+        })
+    })
+}
+
+fn register_plan(raw: HipfftHandle) -> Result<cufftHandle, cufftError_t> {
+    if raw.is_null() {
+        return Err(cufftError_t::r#INVALID_PLAN);
+    }
+    let mut reg = registry()
+        .lock()
+        .map_err(|_| cufftError_t::r#INTERNAL_ERROR)?;
+    for _ in 0..i32::MAX {
+        let id = if reg.next <= 0 { 1 } else { reg.next };
+        reg.next = id.wrapping_add(1);
+        if !reg.plans.contains_key(&id) {
+            reg.plans.insert(id, raw as usize);
+            return Ok(id);
+        }
+    }
+    Err(cufftError_t::r#ALLOC_FAILED)
+}
+
+fn lookup_plan(plan: cufftHandle) -> Result<HipfftHandle, cufftError_t> {
+    let reg = registry()
+        .lock()
+        .map_err(|_| cufftError_t::r#INTERNAL_ERROR)?;
+    reg.plans
+        .get(&plan)
+        .copied()
+        .map(|p| p as HipfftHandle)
+        .ok_or(cufftError_t::r#INVALID_PLAN)
+}
+
+fn remove_plan(plan: cufftHandle) -> Result<HipfftHandle, cufftError_t> {
+    let mut reg = registry()
+        .lock()
+        .map_err(|_| cufftError_t::r#INTERNAL_ERROR)?;
+    reg.plans
+        .remove(&plan)
+        .map(|p| p as HipfftHandle)
+        .ok_or(cufftError_t::r#INVALID_PLAN)
+}
+
+unsafe fn create_registered_with<F>(plan: *mut cufftHandle, create: F) -> cufftResult
+where
+    F: FnOnce(*mut HipfftHandle) -> HipfftResult,
+{
+    if plan.is_null() {
+        return Err(cufftError_t::r#INVALID_VALUE);
+    }
+    let mut raw: HipfftHandle = ptr::null_mut();
+    from_hipfft(create(&mut raw))?;
+    let id = register_plan(raw)?;
+    *plan = id;
+    Ok(())
+}
