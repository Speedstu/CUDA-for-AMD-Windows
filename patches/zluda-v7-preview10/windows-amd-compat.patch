+            .get::<unsafe extern "C" fn(*mut ::core::ffi::c_void, *const ::core::ffi::c_void, usize, i32) -> i32>(b"hipMemcpy\0")
+            .map_err(|_| cublasError_t::r#NOT_INITIALIZED)?;
+        let hip_malloc = *hip_lib
+            .get::<unsafe extern "C" fn(*mut *mut ::core::ffi::c_void, usize) -> i32>(b"hipMalloc\0")
+            .map_err(|_| cublasError_t::r#NOT_INITIALIZED)?;
+        let hip_free = *hip_lib
+            .get::<unsafe extern "C" fn(*mut ::core::ffi::c_void) -> i32>(b"hipFree\0")
+            .map_err(|_| cublasError_t::r#NOT_INITIALIZED)?;
+        let hip_stream_synchronize = *hip_lib
+            .get::<unsafe extern "C" fn(hipStream_t) -> i32>(b"hipStreamSynchronize\0")
+            .map_err(|_| cublasError_t::r#NOT_INITIALIZED)?;
