+macro_rules! impl_getrs_batched {
+    ($name:ident, $ty:ty, $field:ident) => {
+        pub(crate) unsafe fn $name(
+            handle: &Handle,
+            trans: cublasOperation_t,
+            n: i32,
+            nrhs: i32,
+            a_array: *const *const $ty,
+            lda: i32,
+            dev_ipiv: *const i32,
+            b_array: *const *mut $ty,
+            ldb: i32,
+            info: *mut i32,
+            batch_size: i32,
+        ) -> cublasStatus_t {
+            if info.is_null() {
+                return Err(cublasError_t::r#INVALID_VALUE);
+            }
+            *info = 0;
+            if n < 0 { *info = -3; return Err(cublasError_t::r#INVALID_VALUE); }
+            if nrhs < 0 { *info = -4; return Err(cublasError_t::r#INVALID_VALUE); }
+            if lda < 1.max(n) { *info = -6; return Err(cublasError_t::r#INVALID_VALUE); }
+            if ldb < 1.max(n) { *info = -9; return Err(cublasError_t::r#INVALID_VALUE); }
+            if batch_size < 0 { *info = -11; return Err(cublasError_t::r#INVALID_VALUE); }
+            if batch_size == 0 || n == 0 || nrhs == 0 {
+                return Ok(());
+            }
+            if a_array.is_null() || b_array.is_null() {
+                return Err(cublasError_t::r#INVALID_VALUE);
+            }
+            // cuBLAS permits a null pivot array for non-pivoted LU. hipSOLVER's
+            // GETRS ABI requires pivots, so report that backend gap explicitly.
+            if dev_ipiv.is_null() {
+                return Err(cublasError_t::r#NOT_SUPPORTED);
+            }
+
+            let hs = hipsolver()?;
+            let hip_op = hipsolver_operation(trans)?;
+            let mut stream = hip_runtime_sys::hipStream_t(ptr::null_mut());
+            if let Err(e) = rocblas()?.rocblas_get_stream(handle.rocm_handle, &mut stream) {
+                return Err(e.into());
+            }
+            // PyTorch materializes the pointer arrays on the active CUDA stream.
+            // Synchronize before copying only those pointer arrays to host.
+            if (hs.hip_stream_synchronize)(stream) != 0 {
+                return Err(cublasError_t::r#EXECUTION_FAILED);
+            }
+            let a_ptrs = copy_device_pointer_array::<$ty>(hs, a_array as *const *mut $ty, batch_size)?;
+            let b_ptrs = copy_device_pointer_array::<$ty>(hs, b_array, batch_size)?;
+
+            let mut solver_handle = ptr::null_mut::<::core::ffi::c_void>();
+            cublas_error_from_hipsolver((hs.create)(&mut solver_handle))?;
+            if let Err(e) = cublas_error_from_hipsolver((hs.set_stream)(solver_handle, stream)) {
+                let _ = (hs.destroy)(solver_handle);
+                return Err(e);
+            }
+
+            // cuBLAS GETRS exposes a single HOST info integer. hipSOLVER instead
+            // requires a DEVICE devInfo pointer, so keep a private temporary here.
+            let mut dev_info = ptr::null_mut::<::core::ffi::c_void>();
+            if (hs.hip_malloc)(&mut dev_info, mem::size_of::<i32>()) != 0 {
+                let _ = (hs.destroy)(solver_handle);
+                return Err(cublasError_t::r#ALLOC_FAILED);
+            }
+
+            let mut result: cublasStatus_t = Ok(());
+            for i in 0..batch_size as usize {
+                let pivots = dev_ipiv.add(i * n as usize);
+                let status = (hs.$field)(
+                    solver_handle,
+                    hip_op,
+                    n,
+                    nrhs,
+                    a_ptrs[i].cast(),
+                    lda,
+                    pivots,
+                    b_ptrs[i].cast(),
+                    ldb,
+                    dev_info.cast::<i32>(),
+                );
+                if let Err(e) = cublas_error_from_hipsolver(status) {
+                    result = Err(e);
+                    break;
+                }
+            }
+            if result.is_ok() && (hs.hip_stream_synchronize)(stream) != 0 {
+                result = Err(cublasError_t::r#EXECUTION_FAILED);
+            }
+            let info_free = (hs.hip_free)(dev_info);
+            if result.is_ok() && info_free != 0 {
+                result = Err(cublasError_t::r#EXECUTION_FAILED);
+            }
+            let destroy_status = (hs.destroy)(solver_handle);
+            if result.is_ok() {
+                cublas_error_from_hipsolver(destroy_status)?;
+            }
+            result
+        }
+    };
+}
