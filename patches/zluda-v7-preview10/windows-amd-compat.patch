+macro_rules! impl_getrf_batched {
+    ($name:ident, $ty:ty, $buffer_field:ident, $run_field:ident) => {
+        pub(crate) unsafe fn $name(
+            handle: &Handle,
+            n: i32,
+            a_array: *const *mut $ty,
+            lda: i32,
+            pivots: *mut i32,
+            info: *mut i32,
+            batch_size: i32,
+        ) -> cublasStatus_t {
+            if n < 0 || batch_size < 0 || lda < 1.max(n) {
+                return Err(cublasError_t::r#INVALID_VALUE);
+            }
+            if batch_size == 0 || n == 0 {
+                return Ok(());
+            }
+            if a_array.is_null() || info.is_null() {
+                return Err(cublasError_t::r#INVALID_VALUE);
+            }
+            let hs = hipsolver()?;
+            let mut stream = hip_runtime_sys::hipStream_t(ptr::null_mut());
+            if let Err(e) = rocblas()?.rocblas_get_stream(handle.rocm_handle, &mut stream) {
+                return Err(e.into());
+            }
+            if (hs.hip_stream_synchronize)(stream) != 0 {
+                return Err(cublasError_t::r#EXECUTION_FAILED);
+            }
+            let a_ptrs = copy_device_pointer_array::<$ty>(hs, a_array, batch_size)?;
+
+            let mut solver_handle = ptr::null_mut::<::core::ffi::c_void>();
+            cublas_error_from_hipsolver((hs.create)(&mut solver_handle))?;
+            if let Err(e) = cublas_error_from_hipsolver((hs.set_stream)(solver_handle, stream)) {
+                let _ = (hs.destroy)(solver_handle);
+                return Err(e);
+            }
+
+            let mut lwork = 0i32;
+            let query_status = (hs.$buffer_field)(
+                solver_handle, n, n, a_ptrs[0].cast(), lda, &mut lwork,
+            );
+            if let Err(e) = cublas_error_from_hipsolver(query_status) {
+                let _ = (hs.destroy)(solver_handle);
+                return Err(e);
+            }
+            if lwork < 0 {
+                let _ = (hs.destroy)(solver_handle);
+                return Err(cublasError_t::r#INTERNAL_ERROR);
+            }
+            let workspace_bytes = (lwork as usize).saturating_mul(mem::size_of::<$ty>());
+            let mut workspace = ptr::null_mut::<::core::ffi::c_void>();
+            if workspace_bytes > 0 && (hs.hip_malloc)(&mut workspace, workspace_bytes) != 0 {
+                let _ = (hs.destroy)(solver_handle);
+                return Err(cublasError_t::r#ALLOC_FAILED);
+            }
+
+            let mut result: cublasStatus_t = Ok(());
+            for i in 0..batch_size as usize {
+                let pivot_ptr = if pivots.is_null() { ptr::null_mut() } else { pivots.add(i * n as usize) };
+                let status = (hs.$run_field)(
+                    solver_handle,
+                    n,
+                    n,
+                    a_ptrs[i].cast(),
+                    lda,
+                    workspace,
+                    pivot_ptr,
+                    info.add(i),
+                );
+                if let Err(e) = cublas_error_from_hipsolver(status) {
+                    result = Err(e);
+                    break;
+                }
+            }
+            if result.is_ok() && (hs.hip_stream_synchronize)(stream) != 0 {
+                result = Err(cublasError_t::r#EXECUTION_FAILED);
+            }
+            if !workspace.is_null() && (hs.hip_free)(workspace) != 0 && result.is_ok() {
+                result = Err(cublasError_t::r#EXECUTION_FAILED);
+            }
+            let destroy_status = (hs.destroy)(solver_handle);
+            if result.is_ok() {
+                cublas_error_from_hipsolver(destroy_status)?;
+            }
+            result
+        }
+    };
+}
