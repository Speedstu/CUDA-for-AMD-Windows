+    _lib: libloading::os::windows::Library,
+    hip_memcpy: unsafe extern "C" fn(*mut ::core::ffi::c_void, *const ::core::ffi::c_void, usize, i32) -> i32,
+    hip_malloc: unsafe extern "C" fn(*mut *mut ::core::ffi::c_void, usize) -> i32,
+    hip_free: unsafe extern "C" fn(*mut ::core::ffi::c_void) -> i32,
+    hip_stream_synchronize: unsafe extern "C" fn(hipStream_t) -> i32,
+    create: unsafe extern "C" fn(*mut *mut ::core::ffi::c_void) -> i32,
+    destroy: unsafe extern "C" fn(*mut ::core::ffi::c_void) -> i32,
+    set_stream: unsafe extern "C" fn(*mut ::core::ffi::c_void, hipStream_t) -> i32,
+    create_params: unsafe extern "C" fn(*mut *mut ::core::ffi::c_void) -> i32,
+    destroy_params: unsafe extern "C" fn(*mut ::core::ffi::c_void) -> i32,
+    xgeqrf_buffer_size: unsafe extern "C" fn(
+        *mut ::core::ffi::c_void, *mut ::core::ffi::c_void,
+        i64, i64, i32, *const ::core::ffi::c_void, i64,
+        i32, *const ::core::ffi::c_void, i32, *mut usize, *mut usize,
+    ) -> i32,
+    xgeqrf: unsafe extern "C" fn(
+        *mut ::core::ffi::c_void, *mut ::core::ffi::c_void,
+        i64, i64, i32, *mut ::core::ffi::c_void, i64,
+        i32, *mut ::core::ffi::c_void, i32,
+        *mut ::core::ffi::c_void, usize,
+        *mut ::core::ffi::c_void, usize,
+        *mut i32,
+    ) -> i32,
+}
+
+#[cfg(windows)]
+impl HipsolverVtable {
+    unsafe fn new() -> Result<Self, cublasError_t> {
+        // Load the HIP runtime from HIP_PATH first. Keeping this dynamic is crucial on
+        // Windows: a static amdhip64_7 import would resolve to System32 before ZLUDA
+        // can anchor the performance-library stack to the selected HIP/TheRock tree.
+        let hip_module = zluda_windows::try_load_from_self_or_hip_with_message(&["amdhip64_7.dll"])
+            .ok_or(cublasError_t::r#NOT_INITIALIZED)?;
+        let hip_lib = libloading::os::windows::Library::from_raw(hip_module.0 as _);
+        let hip_memcpy = *hip_lib
+            .get::<unsafe extern "C" fn(*mut ::core::ffi::c_void, *const ::core::ffi::c_void, usize, i32) -> i32>(b"hipMemcpy\0")
+            .map_err(|_| cublasError_t::r#NOT_INITIALIZED)?;
+        let hip_malloc = *hip_lib
+            .get::<unsafe extern "C" fn(*mut *mut ::core::ffi::c_void, usize) -> i32>(b"hipMalloc\0")
+            .map_err(|_| cublasError_t::r#NOT_INITIALIZED)?;
+        let hip_free = *hip_lib
+            .get::<unsafe extern "C" fn(*mut ::core::ffi::c_void) -> i32>(b"hipFree\0")
+            .map_err(|_| cublasError_t::r#NOT_INITIALIZED)?;
+        let hip_stream_synchronize = *hip_lib
+            .get::<unsafe extern "C" fn(hipStream_t) -> i32>(b"hipStreamSynchronize\0")
+            .map_err(|_| cublasError_t::r#NOT_INITIALIZED)?;
+
+        let hmodule = zluda_windows::try_load_from_self_or_hip_with_message(&["hipsolver.dll"])
+            .ok_or(cublasError_t::r#NOT_INITIALIZED)?;
+        let lib = libloading::os::windows::Library::from_raw(hmodule.0 as _);
+        macro_rules! sym {
+            ($name:literal, $ty:ty) => {
+                *lib.get::<$ty>(concat!($name, "\0").as_bytes())
+                    .map_err(|_| cublasError_t::r#NOT_INITIALIZED)?
+            };
+        }
+        let create = sym!("hipsolverDnCreate", unsafe extern "C" fn(*mut *mut ::core::ffi::c_void) -> i32);
+        let destroy = sym!("hipsolverDnDestroy", unsafe extern "C" fn(*mut ::core::ffi::c_void) -> i32);
+        let set_stream = sym!("hipsolverDnSetStream", unsafe extern "C" fn(*mut ::core::ffi::c_void, hipStream_t) -> i32);
+        let create_params = sym!("hipsolverDnCreateParams", unsafe extern "C" fn(*mut *mut ::core::ffi::c_void) -> i32);
+        let destroy_params = sym!("hipsolverDnDestroyParams", unsafe extern "C" fn(*mut ::core::ffi::c_void) -> i32);
+        let xgeqrf_buffer_size = sym!("hipsolverDnXgeqrf_bufferSize", unsafe extern "C" fn(
+            *mut ::core::ffi::c_void, *mut ::core::ffi::c_void,
+            i64, i64, i32, *const ::core::ffi::c_void, i64,
+            i32, *const ::core::ffi::c_void, i32, *mut usize, *mut usize,
+        ) -> i32);
+        let xgeqrf = sym!("hipsolverDnXgeqrf", unsafe extern "C" fn(
+            *mut ::core::ffi::c_void, *mut ::core::ffi::c_void,
+            i64, i64, i32, *mut ::core::ffi::c_void, i64,
+            i32, *mut ::core::ffi::c_void, i32,
+            *mut ::core::ffi::c_void, usize,
+            *mut ::core::ffi::c_void, usize,
+            *mut i32,
+        ) -> i32);
+        Ok(Self { _hip_lib: hip_lib, _lib: lib, hip_memcpy, hip_malloc, hip_free, hip_stream_synchronize, create, destroy, set_stream, create_params, destroy_params, xgeqrf_buffer_size, xgeqrf })
+    }
+}
+
+#[cfg(windows)]
+fn hipsolver() -> Result<&'static HipsolverVtable, cublasError_t> {
+    static LOCK: OnceLock<Result<HipsolverVtable, cublasError_t>> = OnceLock::new();
+    LOCK.get_or_init(|| unsafe { HipsolverVtable::new() })
+        .as_ref()
+        .map_err(|e| *e)
+}
+
+#[cfg(windows)]
+fn cublas_error_from_hipsolver(status: i32) -> Result<(), cublasError_t> {
+    match status {
+        0 => Ok(()),
+        1 | 9 => Err(cublasError_t::r#NOT_INITIALIZED),
+        2 => Err(cublasError_t::r#ALLOC_FAILED),
+        3 | 10 => Err(cublasError_t::r#INVALID_VALUE),
+        4 => Err(cublasError_t::r#MAPPING_ERROR),
+        5 => Err(cublasError_t::r#EXECUTION_FAILED),
+        7 | 13 => Err(cublasError_t::r#NOT_SUPPORTED),
+        8 => Err(cublasError_t::r#ARCH_MISMATCH),
+        _ => Err(cublasError_t::r#INTERNAL_ERROR),
+    }
+}
