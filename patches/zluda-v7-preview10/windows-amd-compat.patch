+fn trsm_side(side: cublasSideMode_t) -> Result<rocblas_side, cublasError_t> {
+    match side.0 {
+        0 => Ok(rocblas_side::rocblas_side_left),
+        1 => Ok(rocblas_side::rocblas_side_right),
+        _ => Err(cublasError_t::r#INVALID_VALUE),
+    }
+}
+
+fn trsm_fill(uplo: cublasFillMode_t) -> Result<rocblas_fill, cublasError_t> {
+    match uplo.0 {
+        0 => Ok(rocblas_fill::rocblas_fill_lower),
+        1 => Ok(rocblas_fill::rocblas_fill_upper),
+        _ => Err(cublasError_t::r#INVALID_VALUE),
+    }
+}
+
+fn trsm_operation(trans: cublasOperation_t) -> Result<rocblas_operation, cublasError_t> {
+    match trans.0 {
+        0 => Ok(rocblas_operation::rocblas_operation_none),
+        1 => Ok(rocblas_operation::rocblas_operation_transpose),
+        2 => Ok(rocblas_operation::rocblas_operation_conjugate_transpose),
+        _ => Err(cublasError_t::r#NOT_SUPPORTED),
+    }
+}
+
+fn trsm_diagonal(diag: cublasDiagType_t) -> Result<rocblas_diagonal, cublasError_t> {
+    match diag.0 {
+        0 => Ok(rocblas_diagonal::rocblas_diagonal_non_unit),
+        1 => Ok(rocblas_diagonal::rocblas_diagonal_unit),
+        _ => Err(cublasError_t::r#INVALID_VALUE),
+    }
+}
