+fn hipsolver_operation(trans: cublasOperation_t) -> Result<i32, cublasError_t> {
+    match trans.0 {
+        0 => Ok(111), // HIPBLAS_OP_N
+        1 => Ok(112), // HIPBLAS_OP_T
+        2 => Ok(113), // HIPBLAS_OP_C
+        _ => Err(cublasError_t::r#NOT_SUPPORTED),
+    }
+}
