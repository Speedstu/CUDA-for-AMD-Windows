-pub(crate) unsafe fn device_get_memory_info(
-    _device: cuda_types::nvml::nvmlDevice_t,
-    _memory: &mut cuda_types::nvml::nvmlMemory_t,
-) -> nvmlReturn_t {
-    crate::impl_common::unimplemented()
+pub(crate) unsafe fn device_get_memory_info(device: nvmlDevice_t, memory: &mut nvmlMemory_t) -> nvmlReturn_t {
+    let index = match index_from_handle(device) {
+        Ok(i) => i,
+        Err(e) => return e,
+    };
+    if !valid_index(index as u32) {
+        return nvmlReturn_t::ERROR_INVALID_ARGUMENT;
+    }
+
+    let mut total = 0usize;
+    if hipDeviceTotalMem(&mut total, index).is_err() {
+        return nvmlReturn_t::ERROR_UNKNOWN;
+    }
+
+    let mut previous = 0i32;
+    let have_previous = hipGetDevice(&mut previous).is_ok();
+    if hipSetDevice(index).is_err() {
+        return nvmlReturn_t::ERROR_UNKNOWN;
+    }
+    let mut free = 0usize;
+    let mut current_total = 0usize;
+    let mem_result = hipMemGetInfo(&mut free, &mut current_total);
+    if have_previous && previous != index {
+        let _ = hipSetDevice(previous);
+    }
+    if mem_result.is_err() {
+        return nvmlReturn_t::ERROR_UNKNOWN;
+    }
+
+    let effective_total = if current_total > 0 { current_total } else { total };
+    memory.total = effective_total as u64;
+    memory.free = free.min(effective_total) as u64;
+    memory.used = effective_total.saturating_sub(free.min(effective_total)) as u64;
+    nvmlReturn_t::SUCCESS
 }
 
