+    // Free/used memory is only queried when a CUDA context already exists.
+    // Creating or switching a hidden context from NVML would be observable by
+    // the application and previously caused cross-library initialization bugs.
+    let mut free = total;
+    if let (Ok(ctx_get), Ok(mem_get)) = (
+        symbol::<unsafe extern "system" fn(*mut CuContext) -> CuResult>(b"cuCtxGetCurrent\0"),
+        symbol::<unsafe extern "system" fn(*mut usize, *mut usize) -> CuResult>(b"cuMemGetInfo_v2\0"),
