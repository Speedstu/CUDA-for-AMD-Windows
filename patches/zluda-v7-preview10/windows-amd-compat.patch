+pub(crate) unsafe fn device_get_memory_info(device: nvmlDevice_t, memory: &mut nvmlMemory_t) -> nvmlReturn_t {
+    let index = match index_from_handle(device) {
+        Ok(i) => i,
+        Err(e) => return e,
+    };
+    if !valid_index(index as u32) {
+        return nvmlReturn_t::ERROR_INVALID_ARGUMENT;
+    }
+
+    let total_mem = match symbol::<unsafe extern "system" fn(*mut usize, CuDevice) -> CuResult>(
+        b"cuDeviceTotalMem_v2\0",
+    ) {
+        Ok(f) => f,
+        Err(e) => return e,
